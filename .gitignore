# Ignore OS images
metal/images/*
!metal/images/.gitkeep

# Ignore downloaded packages installed by post-flash setups
metal/packages/*
!metal/packages/.gitkeep

# Environment files
**/.env

# Caddy runtime data
services/caddy/caddy-data/
services/caddy/caddy-config/

# Immich user data
services/immich/library/
services/immich/postgres/

# Vaultwarden data
services/vaultwarden/data/

# Jellyfin data
services/jellyfin/config/
services/jellyfin/cache/
services/jellyfin/media/

# Papra data
services/papra/app-data/
services/papra/ingestion/

# Storyteller data
services/storyteller/data/

# Frigate data
services/frigate/media/
services/frigate/config/*
!services/frigate/config/config.yml
